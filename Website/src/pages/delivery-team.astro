---
// The delivery team. Role-based only while consents are outstanding: a
// practitioner is named and pictured here once they have signed Section 4
// (website and tender consent) of the Lavelle Required Information Form. That
// signature is the only precondition — a contract or agreed rate is not.
// See CLAUDE.md → "Delivery team consent gate".
import BaseLayout from "../layouts/BaseLayout.astro";

const roles = [
  {
    num: "Delivery",
    title: "Project & Programme Manager",
    desc: "Runs the plan, the schedule, the RAID log and the reporting line, and holds the delivery goals the team commits to at each stage. Chairs the working rhythm underneath the steering committee, so escalations arrive with a recommendation attached rather than as a surprise.",
  },
  {
    num: "Analysis",
    title: "Business Analyst",
    desc: "Produces the requirements baseline a delivery team can build from: process models, use cases, screen and workflow specifications and a traceability matrix that survives scope change. On a Lavelle engagement the analyst owns the artefact trail from discovery findings through to signed-off requirements.",
  },
  {
    num: "Adoption",
    title: "Change Manager",
    desc: "Owns the change discovery assessment, stakeholder map, communications plan and training plan, so the operational side of go-live is planned as tightly as the technical side. Delivers the adoption measures the steering committee will ask about after cutover.",
  },
  {
    num: "Quality",
    title: "Test & QA Specialist",
    desc: "Writes the test strategy, test plan and scripts, then runs the cycles and reports defects against a defined exit standard. Produces the test summary report that the go / no-go decision rests on.",
  },
  {
    num: "Architecture",
    title: "Solution Architect",
    desc: "Sets the technical direction the build is delivered against: solution options, integration architecture, non-functional requirements and a decision record that survives staff turnover. The senior developer builds to the architecture; the architect stays accountable for it holding in production.",
  },
  {
    num: "Build",
    title: "Senior Developer",
    desc: "Leads technical design and the hard build work, sets the code standard for the assignment and reviews what the rest of the build team produces. Accountable for the technical artefacts that go into operational acceptance.",
  },
  {
    num: "Build",
    title: "Mid Developer",
    desc: "Builds to the agreed design and specification, working through the delivery backlog under senior review. Carries the bulk of feature build and defect resolution across a release.",
  },
  {
    num: "Build",
    title: "Junior Developer",
    desc: "Takes defined, well-scoped tasks under supervision: configuration, content build, defect fixes and test support. Every output is reviewed by the senior developer before it reaches a client environment.",
  },
  {
    num: "Design",
    title: "Content & UX Strategist",
    desc: "Owns information architecture, content model and interface flow, backed by the service analysis and gap analysis that show why the design holds. Delivers the structure a platform build is configured against.",
  },
];
---

<BaseLayout
  title="The delivery team - Lavelle Pty Ltd"
  currentNav="delivery-team"
  description="Lavelle Pty Ltd delivers through a principal-led team: Sky Lavelle on every engagement, with project and programme management, business analysis, change, test and QA, solution architecture, development and UX practitioners engaged per assignment under Lavelle master agreements."
>
  <!-- SUB-PAGE HERO -->
  <section class="subhero">
    <div class="wrap">
      <div class="subhero__crumb">
        <a href="/">Home</a> &nbsp;/&nbsp; <span>Delivery team</span>
      </div>
      <h1>
        One company, one contract. <em>A team sized to the work.</em>
      </h1>
      <p class="subhero__lead">
        Lavelle Pty Ltd delivers through a principal-led team. Sky Lavelle leads
        every engagement personally, and only the specialists that piece of work
        needs are engaged alongside him - often two or three, not nine - as
        independent subcontractors through their own companies, under Lavelle
        master agreements. The client holds one commercial relationship: one
        company, one contract, one invoice.
      </p>
      <div class="hero__ctas" style="margin-top:1.25rem;">
        <a href="/contact" class="btn btn--primary">
          Engage the team <span class="btn__arrow">→</span>
        </a>
        <a href="/contact?topic=capability" class="btn btn--ghost"
          >Request a capability statement</a
        >
      </div>
    </div>
  </section>

  <!-- THE MODEL -->
  <section style="background:var(--paper);">
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">The model</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            Senior judgement at the top.<br /><em
              >Right-sized specialists underneath.</em
            >
          </h2>
        </div>
        <p class="lead">
          Most delivery problems are not caused by a shortage of hands. They are
          caused by nobody senior holding the shape of the work, so the team
          builds the wrong thing carefully.
        </p>
      </header>

      <div class="prose">
        <p>
          Every Lavelle engagement is led by Sky as principal. He sets the
          delivery approach, directs the practitioners on the assignment,
          reviews what they produce and stays accountable to the sponsor for the
          result. Practitioners are engaged per assignment rather than carried
          as bench, so the team is sized to the work in front of it instead of
          the work the supplier wants to sell.
        </p>
        <p>
          Every practitioner works to the
          <a href="/framework" class="link-inline">Lavelle Delivery Framework</a
          >
          and the <a href="/resources" class="link-inline"
            >house artefact standards</a
          >, which means the outputs look the same whoever produced them: the
          same status reporting, the same RAID discipline, the same decision
          trail. Where a tier-one firm gives you a partner at the pitch and a
          graduate on the work, this model keeps the senior judgement on the
          engagement and adds specialist capability under it.
        </p>
        <p>
          The commercial side is deliberately simple. Lavelle Pty Ltd contracts
          with the client, engages each practitioner under its own master
          agreement, and issues a single invoice. Insurance, contracting and
          delivery accountability sit with one company, so the client is not
          managing a panel of individuals.
        </p>
      </div>
    </div>
  </section>

  <!-- PRINCIPAL -->
  <section>
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">Principal</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            On every <em>engagement.</em>
          </h2>
        </div>
        <p class="lead">
          The principal is not a name on the proposal. Sky is the delivery lead
          on the assignment and the person the steering committee holds to
          account.
        </p>
      </header>

      <article class="principal">
        <div class="principal__body">
          <h3 class="principal__name">Sky Lavelle</h3>
          <div class="principal__role">
            Director and principal consultant, Lavelle Pty Ltd
          </div>
          <p>
            Twenty years in enterprise technology and digital transformation
            across media and broadcasting, higher education, government and
            not-for-profit. Recent work spans concurrent workstreams under
            senior governance at a national public broadcaster, a decade across
            Australian universities covering CMS replacement, marketing
            automation and CRM rollout, and Head of Project Delivery at a
            federally-funded cyber security research centre.
          </p>
          <p>
            Recipient of a university Senior Leadership Award, awarded after
            delivery of an enterprise content management programme. He is the
            author of the Lavelle Delivery Framework and the artefact library
            the team delivers against.
          </p>
          <div class="principal__links">
            <a href="/about" class="cap__link"
              >About the company <span>→</span></a
            >
            <a href="/case-studies" class="cap__link"
              >Case studies <span>→</span></a
            >
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ROLES -->
  <section style="background:var(--paper);">
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">The roles</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            Nine roles.<br />Take <em>only what the work needs.</em>
          </h2>
        </div>
        <p class="lead">
          These are the roles available, not a team that arrives together. Most
          engagements draw on two or three of them; a large programme might use
          six. Each role is described by what it delivers rather than the hours
          it supplies, so the shape of the team is a scoping decision rather
          than a package.
        </p>
      </header>

      <div class="capabilities">
        {
          roles.map((role) => (
            <article class="cap">
              <div class="cap__num">{role.num}</div>
              <h3 class="cap__title">{role.title}</h3>
              <p class="cap__desc">{role.desc}</p>
            </article>
          ))
        }
      </div>

      <p class="roles__note">
        Only the roles an engagement needs are filled, and they are engaged for
        that assignment under Lavelle master agreements, as independent
        subcontractors through their own companies. Work is delivered as defined
        deliverables under the principal's direction.
      </p>
    </div>
  </section>

  <!-- ENGAGE -->
  <section class="engage">
    <div class="wrap">
      <div class="engage__grid">
        <div>
          <div class="eyebrow">Ready when you are</div>
          <h2 style="margin-top:1.25rem;">
            Bring in <em>the team,</em> not a panel of contractors.
          </h2>
          <p class="lead" style="margin-top:1.5rem;">
            Tell us the shape of the work and we will tell you which roles it
            needs. The first conversation is confidential, structured and free.
          </p>
          <div class="hero__ctas" style="margin-top:1.25rem;">
            <a href="/contact" class="btn btn--primary">
              Engage the team <span class="btn__arrow">→</span>
            </a>
          </div>
        </div>

        <ul class="engage__list">
          <li>
            <a href="/contact?topic=capability"
              ><span>Request a capability statement</span><span>→</span></a
            >
          </li>
          <li>
            <a href="/contact?topic=brief"
              ><span>Submit a brief (RFP / EOI)</span><span>→</span></a
            >
          </li>
          <li>
            <a href="/consulting"
              ><span>See the six capabilities</span><span>→</span></a
            >
          </li>
          <li>
            <a href="/framework"
              ><span>The Lavelle Delivery Framework</span><span>→</span></a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .principal {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    padding: 2.5rem 2rem;
  }
  @media (min-width: 880px) {
    .principal {
      padding: 3rem;
    }
  }
  .principal__body {
    max-width: 62ch;
  }
  .principal__name {
    font-family: "Fraunces", serif;
    font-size: var(--display-sm);
    font-weight: 500;
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }
  .principal__role {
    font-size: var(--micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 1.5rem;
  }
  .principal__body p {
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }
  .principal__links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .roles__note {
    margin-top: 2rem;
    font-size: var(--body-sm);
    color: var(--sage);
    max-width: 62ch;
  }
</style>
