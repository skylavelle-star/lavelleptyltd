---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import staircaseImage from "../assets/images/framework-staircase.jpg";
import engageImage from "../assets/images/engage-boardroom.jpg";

const stages = [
  {
    number: "01",
    name: "Initiation",
    produces: "Sponsor, mandate, business case and team in place",
    description:
      "Establish sponsor intent, the mandate and the governance around it, get the business case approved and stand the team up. Initiation ends when there is authority to plan and someone accountable for the outcome.",
    icon: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/>',
  },
  {
    number: "02",
    name: "Planning",
    produces: "Project plan, schedule, RAID log and financial model",
    description:
      "Build the control baseline: the project plan and schedule, the RAID log and the bottom-up financial model. The delivery goals the team will work to are fixed here, which is what makes the agile layer underneath accountable.",
    icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  },
  {
    number: "03",
    name: "Delivery",
    produces: "Design, build, test and cutover against defined goals",
    description:
      "The team runs iterative cycles - plan, build, review, refine - against the delivery goals set at Planning, through design, build, test and cutover. The control layer above keeps reporting to its own cadence while the cycles run.",
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    number: "04",
    name: "Monitor",
    produces: "Performance, benefits, stability and financial reconciliation",
    description:
      "The traditional monitor-and-control phase, run after Delivery and before Closure. Hypercare, operational acceptance, benefits tracking and the financial reconciliation - the phase where the claim made in the business case gets tested against live running.",
    icon: '<path d="M2 12h4l3-9 4 18 3-9h6"/>',
  },
  {
    number: "05",
    name: "Closure",
    produces: "Handover, reconciliation, lessons and formal close",
    description:
      "Handover to the business, final reconciliation, lessons captured and the project formally closed. There is no gate out of Closure: it ends with the End Project Report signed off, because closure is the exit rather than another decision to take.",
    icon: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  },
];

const layers = [
  {
    name: "Predictive",
    summary: "The control layer.",
    bestFor:
      "Tolerances, stage boundaries and a paper trail for senior leadership. Runs the whole length of the project: mandate, business case, scope, estimate, benefits framed, mobilise, then design through go-live, monitor and closure.",
  },
  {
    name: "Iterative",
    summary: "The team layer.",
    bestFor:
      "Short cycles against the delivery goals fixed at Planning: problem hypothesis, goals set, sprints running, increment reviewed, solution integrity checked, release and deploy, outcomes and next bets.",
  },
  {
    name: "Hybrid",
    summary: "The Vantage Meridian default.",
    bestFor:
      "PRINCE2 control at the programme layer, agile cadence at the team layer. Senior leadership sees a gated, predictive project. The team inside Delivery works in cycles. Neither has to pretend to be the other.",
  },
];

const gates = [
  {
    id: "G1",
    name: "Authorise Planning",
    closes: "Initiation",
    decider: "Sponsor / deciding body",
    decisions: [
      "Business Case approved",
      "Scope & HLR sign-off",
      "SteerCo Charter sign-off",
    ],
  },
  {
    id: "G2",
    name: "Authorise Delivery",
    closes: "Planning",
    decider: "Steering committee",
    decisions: [
      "Project Plan sign-off",
      "Cost Plan and budget approved",
      "RAID Log baselined",
    ],
  },
  {
    id: "G3",
    name: "Authorise Monitoring",
    closes: "Delivery",
    decider: "Steering committee / sponsor",
    decisions: [
      "Go No-Go Checklist sign-off",
      "Release Plan executed",
      "Deployment verified",
    ],
  },
  {
    id: "G4",
    name: "Authorise Closure",
    closes: "Monitor",
    decider: "Sponsor + business owner",
    decisions: [
      "Operational acceptance signed",
      "Benefits handover accepted",
      "Financials reconciled",
    ],
  },
];
---

<BaseLayout
  title="Framework - Vantage Meridian"
  description="The Vantage Meridian Delivery Framework. Five phases, four gates, one hybrid discipline: PRINCE2 control and tolerances for senior leadership, agile cycles inside the Delivery team."
>
  <section class="subhero">
    <div class="wrap">
      <div class="subhero__crumb">
        <a href="/">Home</a> &nbsp;/&nbsp; <span>Framework</span>
      </div>
      <h1>
        The Vantage Meridian Delivery Framework. <em
          >Five phases. Four gates. One hybrid.</em
        >
      </h1>
      <p class="subhero__lead">
        A practical structure for delivering complex technology and business
        change. Five phases give the work shape and four gates give it
        assurance. The model is a deliberate PRINCE2 + Agile hybrid: predictive
        stage gates and controls for the steering layer, agile cycles with
        defined delivery goals inside the team. The framework is the
        navigational spine of this site: every template, pack and bundle links
        back to its phase and gate.
      </p>
    </div>
  </section>

  <section class="case--imaged">
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">Framework</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            The five <em>phases.</em>
          </h2>
        </div>
        <p class="lead">
          Initiation puts the sponsor, mandate, case and team in place. Planning
          builds the baseline. Delivery does the work. Monitor proves it holds
          in live running, and Closure hands it over and shuts the project down
          on purpose.
        </p>
      </header>

      <figure class="case__image">
        <Image
          src={staircaseImage}
          alt="A clean white spiral staircase rising through a light-filled atrium - the five phases ascend the same way"
          widths={[640, 960, 1280, 1800]}
          sizes="(min-width: 1080px) 1100px, 100vw"
          loading="lazy"
          decoding="async"
          class="case__image-img"
        />
      </figure>

      <div class="stages">
        {
          stages.map((stage) => (
            <article class="stage">
              <div class="stage__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={stage.icon}
                />
              </div>
              <div class="stage__num">{stage.number}</div>
              <h3 class="stage__title">{stage.name}</h3>
              <div class="stage__meta">
                <span class="stage__produces">Produces: {stage.produces}</span>
              </div>
              <p class="stage__desc">{stage.description}</p>
            </article>
          ))
        }
      </div>

      <aside class="not-a-stage">
        <div class="not-a-stage__label">Important</div>
        <p>
          <strong>Recovery is not a stage.</strong> Project Recovery is a consulting
          offer (see <a href="/consulting#recovery" class="link-inline"
            >Consulting</a
          >). It sits across the framework, not inside it.
        </p>
      </aside>
    </div>
  </section>

  <section style="background:var(--paper);">
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">The hybrid model</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            Five phases. <em>One hybrid discipline.</em>
          </h2>
        </div>
        <p class="lead">
          Waterfall on the outside, agile on the inside. Senior leadership sees
          a predictive, gated project with tolerances and a paper trail, while
          the team inside Delivery runs iterative cycles toward the delivery
          goals fixed at Planning.
        </p>
      </header>

      <div class="paths">
        {
          layers.map((layer) => (
            <article class="path">
              <div class="path__label">{layer.name}</div>
              <h3 class="path__title">{layer.summary}</h3>
              <p class="path__best">{layer.bestFor}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <header class="section__head">
        <div>
          <div class="eyebrow">Governance assurance</div>
          <h2 class="section__title" style="margin-top:1.25rem;">
            The four <em>gates.</em>
          </h2>
        </div>
        <p class="lead">
          Each gate is a named decision with a named decider, and each one
          closes a phase. There is no gate out of Closure - the project ends
          with the End Project Report signed off, because closure is the exit
          rather than another decision to take. Gates sit in the control layer,
          so the team keeps working to its cycle while the decision is taken.
        </p>
      </header>

      <div class="gates">
        {
          gates.map((gate) => (
            <article class="gate">
              <div class="gate__head">
                <span class="gate__id">{gate.id}</span>
                <span class="gate__name">{gate.name}</span>
              </div>
              <div class="gate__closes">
                Closes {gate.closes} · {gate.decider}
              </div>
              <ul class="gate__decisions">
                {gate.decisions.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="engage engage--imaged">
    <figure class="engage__bg" aria-hidden="true">
      <Image
        src={engageImage}
        alt=""
        widths={[960, 1440, 1920, 2400]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="engage__bg-img"
      />
    </figure>
    <div class="wrap">
      <div class="engage__grid">
        <div>
          <div class="eyebrow">Apply this framework</div>
          <h2 style="margin-top:1.25rem;">Need help <em>applying it?</em></h2>
          <p class="lead" style="margin-top:1.5rem;">
            Every artefact is wired to a phase and a gate of the framework, and
            the <a href="/articles" class="link-inline">articles</a>
            work through how the phases play out in practice. The Tailoring Calculator
            sizes the governance to the work. Consulting picks up where templates
            leave off.
          </p>
          <div class="hero__ctas" style="margin-top:1.25rem;">
            <a href="/contact" class="btn btn--primary">
              Engage Vantage Meridian <span class="btn__arrow">→</span>
            </a>
            <a
              href="/free-tools"
              class="btn"
              style="background:transparent; color:var(--bone); border:1px solid var(--bone);"
            >
              Free tools
            </a>
          </div>
        </div>
        <ul class="engage__list">
          <li>
            <a href="/consulting">
              <span class="engage__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
                  ></path><rect width="20" height="14" x="2" y="6" rx="2"
                  ></rect></svg
                >
              </span>
              <span>Consulting capabilities</span>
              <span class="engage__arrow">→</span>
            </a>
          </li>
          <li>
            <a href="/free-tools">
              <span class="engage__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect width="18" height="18" x="3" y="3" rx="2"></rect><path
                    d="M8 7v10"></path><path d="M16 7v10"></path><path
                    d="M8 12h8"></path></svg
                >
              </span>
              <span>Free tools &amp; Tailoring Calculator</span>
              <span class="engage__arrow">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stages {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .stages {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1080px) {
    .stages {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .stage {
    background: var(--bone);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--ochre);
    padding: 1.75rem;
  }
  .stage__icon {
    color: var(--ochre);
    margin-bottom: 0.85rem;
    line-height: 0;
  }
  .stage__num {
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--ochre);
    margin-bottom: 0.6rem;
  }
  .stage__title {
    font-family: "Fraunces", serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .stage__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.85rem;
  }
  .stage__duration {
    color: var(--ochre);
    font-weight: 500;
  }
  .stage__desc {
    font-size: var(--body-sm);
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .not-a-stage {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    background: var(--bone);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ink);
  }
  .not-a-stage__label {
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .not-a-stage p {
    font-size: var(--body-sm);
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
    max-width: 72ch;
  }

  .paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 860px) {
    .paths {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .path {
    background: var(--bone);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--ochre);
    padding: 1.75rem;
  }
  .path__label {
    font-family: "DM Sans", sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ochre);
    margin-bottom: 0.75rem;
  }
  .path__title {
    font-family: "Fraunces", serif;
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.85rem;
    line-height: 1.25;
  }
  .path__best {
    font-size: var(--body-sm);
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .gates {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .gates {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1080px) {
    .gates {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gate {
    background: var(--bone);
    border: 1px solid var(--rule);
    padding: 1.5rem;
    border-left: 3px solid var(--ochre);
  }
  .gate__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .gate__id {
    font-family: "DM Sans", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--ochre);
  }
  .gate__name {
    font-family: "Fraunces", serif;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
  }
  .gate__closes {
    font-size: var(--micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.75rem;
  }
  .gate__decisions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .gate__decisions li {
    font-size: var(--body-sm);
    color: var(--ink-soft);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }
  .gate__decisions li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 1px;
    background: var(--ochre);
  }
</style>
